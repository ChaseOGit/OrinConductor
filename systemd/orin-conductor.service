[Unit]
Description=OrinConductor v4 Autonomous Edge-to-Cloud AI Systems Orchestrator
After=network.target

[Service]
Type=simple
User=orin
WorkingDirectory=/opt/orin-native
EnvironmentFile=/opt/orin-native/conductor.env
ExecStartPre=/bin/bash -c 'rm -f .git/index.lock && sudo nvpmodel -m 0 || true'
ExecStart=/usr/bin/python3 /opt/orin-native/orin_conductor.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
